# Copy to infra/.env (git-ignored) and fill in. None of these values is a secret.
EQ="myteam"                          # team name: lowercase letters/digits only
LOC="francecentral"                  # a region allowed by your policy AND by Flex Consumption
GH_REPO="github-account/repo-name"   # e.g. alice/dscc-pipeline
ALERT_EMAIL="you@example.com"        # receives the budget and monitoring alerts
